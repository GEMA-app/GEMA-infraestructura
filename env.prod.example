# =============================================================================
# GEMA - Variables de Entorno - PRODUCCIÓN
# =============================================================================
# INSTRUCCIONES:
#   1. Copia este archivo: cp .env.prod.example .env
#   2. Rellena TODOS los valores. No dejes ninguno con el valor de ejemplo.
#   3. NUNCA subas el archivo .env al repositorio (está en .gitignore)
#   4. Genera SECRET_KEY con: openssl rand -hex 32
# =============================================================================

# -----------------------------------------------------------------------------
# BASE DE DATOS - PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_DB=gema_db
POSTGRES_USER=gema_user
POSTGRES_PASSWORD=CAMBIA_ESTO_minimo16caracteres_seguro
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://gema_user:CAMBIA_ESTO_minimo16caracteres_seguro@db:5432/gema_db

# -----------------------------------------------------------------------------
# CACHÉ - Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# SEGURIDAD - JWT
# Genera con: openssl rand -hex 32
# -----------------------------------------------------------------------------
SECRET_KEY=GENERA_CON_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# -----------------------------------------------------------------------------
# FRONTEND - Next.js
# Cambia por la IP del Droplet hasta tener dominio
# Ejemplo con IP:    http://167.99.123.45
# Ejemplo con dominio: https://gema.tudominio.com
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://<IP_DROPLET>
