# =============================================================================
# GEMA - Gestión Estratégica de Mantenimiento de Activos
# Variables de Entorno - Plantilla de ejemplo
# =============================================================================
# INSTRUCCIONES:
#   1. Copia este archivo: cp .env.example .env
#   2. Rellena los valores reales en .env
#   3. NUNCA subas el archivo .env al repositorio (está en .gitignore)
#   4. En producción, usa un gestor de secretos (AWS Secrets Manager,
#      HashiCorp Vault, etc.) en lugar de un archivo .env
# =============================================================================

# -----------------------------------------------------------------------------
# BASE DE DATOS - PostgreSQL
# -----------------------------------------------------------------------------

# Nombre de la base de datos principal de GEMA
POSTGRES_DB=gema_db

# Usuario con acceso a la base de datos
POSTGRES_USER=gema_user

# Contraseña del usuario de la base de datos.
# IMPORTANTE: Usa una contraseña segura y única. Mínimo 16 caracteres,
# combinando mayúsculas, minúsculas, números y símbolos.
POSTGRES_PASSWORD=cambia_esta_contrasena_segura

# Host de la base de datos.
# En el entorno Docker usa "db" (nombre del servicio en docker-compose.yml).
# Para desarrollo local fuera de Docker, usa "localhost".
POSTGRES_HOST=db

# Puerto de PostgreSQL (por defecto 5432)
POSTGRES_PORT=5432

# URL de conexión completa para SQLAlchemy / Alembic.
# Formato: postgresql+asyncpg://usuario:contraseña@host:puerto/nombre_db
# Asegúrate de que coincida con las variables anteriores.
DATABASE_URL=postgresql+asyncpg://gema_user:cambia_esta_contrasena_segura@db:5432/gema_db

# -----------------------------------------------------------------------------
# CACHÉ - Redis
# -----------------------------------------------------------------------------

# URL de conexión a Redis.
# En el entorno Docker usa "redis" (nombre del servicio en docker-compose.yml).
# Para desarrollo local fuera de Docker, usa "localhost".
# Formato: redis://[usuario:contraseña@]host:puerto/número_db
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# SEGURIDAD - JWT (JSON Web Tokens)
# -----------------------------------------------------------------------------

# Clave secreta para firmar los tokens JWT.
# IMPORTANTE: Genera una clave aleatoria y segura con:
#   openssl rand -hex 32
# Nunca uses la clave de ejemplo en producción.
SECRET_KEY=genera_una_clave_secreta_segura_con_openssl_rand_hex_32

# Algoritmo de firma para JWT (HS256 es el estándar recomendado)
ALGORITHM=HS256

# Tiempo de expiración del token de acceso en minutos.
# 30 minutos es un valor seguro para la mayoría de aplicaciones.
# Ajusta según las necesidades de UX de GEMA.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# -----------------------------------------------------------------------------
# FRONTEND - Next.js
# -----------------------------------------------------------------------------

# URL pública de la API que el navegador usará para hacer peticiones.
# En desarrollo: http://localhost:8000
# En producción: https://api.tu-dominio.com
# NOTA: Las variables NEXT_PUBLIC_* son expuestas al navegador. No pongas
# secretos en variables con este prefijo.
NEXT_PUBLIC_API_URL=http://localhost:8000
